# =============================================================================
# AHSORA MEDS ACADEMY - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CORE (Required)
# Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key — KEEP SECRET, server-side only, never expose to the browser
# Used for admin operations like bypassing RLS, sending emails via service role, etc.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# JWT Secret — found in Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "false" when connecting to a real Supabase project (enables live data)
NEXT_PUBLIC_DEMO_MODE=true

# -----------------------------------------------------------------------------
# SUPABASE STORAGE (for file uploads — documents, avatars, etc.)
# Bucket names you create in Supabase Dashboard → Storage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_DOCUMENTS=student-documents
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_COURSE_ASSETS=course-assets

# -----------------------------------------------------------------------------
# EMAIL (Optional — use Resend or SendGrid for transactional emails)
# Configure templates in Supabase Dashboard → Authentication → Email Templates
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=noreply@ahsorameds.com

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Optional — Stripe example)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# -----------------------------------------------------------------------------
# ANALYTICS (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
